  "dialogue": [
    {
      "id": "L1",
      "speaker": "narrator",
      "voice": "bm_george",
      "speed": 1.08,
      "start": 0.20,
      "maxEnd": 3.25,
      "text": "For a thousand years, geniuses thought your eyes shoot lasers."
    },
    {
      "id": "L2",
      "speaker": "rival",
      "voice": "am_michael",
      "speed": 1.06,
      "start": 3.35,
      "maxEnd": 4.40,
      "text": "Behold my vision beams!"
    },
    {
      "id": "L3",
      "speaker": "narrator",
      "voice": "bm_george",
      "speed": 1.06,
      "start": 4.65,
      "maxEnd": 7.35,
      "text": "Then Cairo polymath Ibn al-Haytham stepped into total darkness."
    },
    {
      "id": "L4",
      "speaker": "alhazen",
      "voice": "bm_lewis",
      "speed": 1.04,
      "start": 7.45,
      "maxEnd": 9.40,
      "text": "If eyes shoot light, why can't you see now?"
    },
    {
      "id": "L5",
      "speaker": "narrator",
      "voice": "bm_george",
      "speed": 1.05,
      "start": 9.70,
      "maxEnd": 15.20,
      "text": "Through one tiny pinhole, candle rays raced straight, crossed over, and projected the flame..."
    },
    {
      "id": "L6",
      "speaker": "rival",
      "voice": "am_michael",
      "speed": 1.12,
      "start": 15.55,
      "maxEnd": 17.35,
      "text": "Wait—why is it upside down?!"
    },
    {
      "id": "L7",
      "speaker": "alhazen",
      "voice": "bm_lewis",
      "speed": 1.05,
      "start": 17.50,
      "maxEnd": 20.25,
      "text": "Because light enters your eye—it never shoots out!"
    },
    {
      "id": "L8",
      "speaker": "narrator",
      "voice": "bm_george",
      "speed": 1.05,
      "start": 20.60,
      "maxEnd": 25.10,
      "text": "He built the Camera Obscura—and unlocked human vision."
    },
    {
      "id": "L9",
      "speaker": "narrator",
      "voice": "bm_george",
      "speed": 1.04,
      "start": 25.55,
      "maxEnd": 29.45,
      "text": "Every phone camera today? Still inside his dark room."
    }
  ],
